<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane fx:id="clearLayout" stylesheets="@../Styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <VBox alignment="CENTER">
        <Label text="Label" textAlignment="CENTER">
         <font>
            <Font size="48.0" />
         </font>
         <VBox.margin>
            <Insets top="50.0" />
         </VBox.margin></Label>
        <StackPane styleClass="neon-wrapper">
            <VBox alignment="CENTER">
                <padding>
                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                </padding>
                <Label styleClass="gameLabels" text="Score:" textAlignment="CENTER">
                    <font>
                        <Font size="24.0" />
                    </font>
                </Label>
                <Label styleClass="gameLabels" text="0" />
                <Label styleClass="gameLabels" text="Level:">
                    <font>
                        <Font size="24.0" />
                    </font>
                </Label>
                <Label styleClass="gameLabels" text="0" />
                <Label styleClass="gameLabels" text="Lines Cleared:">
                    <font>
                        <Font size="24.0" />
                    </font>
                </Label>
                <Label styleClass="gameLabels" text="0" />
            </VBox>
         <VBox.margin>
            <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
         </VBox.margin>
        </StackPane>
        <HBox alignment="CENTER">
            <Button mnemonicParsing="false" text="Main Menu">
                <HBox.margin>
                    <Insets right="10.0" />
                </HBox.margin>
            </Button>
            <Button mnemonicParsing="false" text="Replay">
                <HBox.margin>
                    <Insets left="10.0" />
                </HBox.margin>
            </Button>
         <VBox.margin>
            <Insets bottom="50.0" />
         </VBox.margin>
        </HBox>
      <StackPane.margin>
         <Insets />
      </StackPane.margin>
    </VBox>
</StackPane>
